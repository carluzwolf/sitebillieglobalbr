{
  "rules": {
    ".read": false,
    ".write": false,
    "users": {
      "$uid": {
        ".read": "root.child('admins').child(auth.uid).exists() || (auth != null && auth.uid === $uid)",
        ".write": "root.child('admins').child(auth.uid).exists() || (auth != null && auth.uid === $uid)",
        "name": {
          ".validate": "root.child('admins').child(auth.uid).exists() || (newData.isString() && newData.val().length >= 1 && newData.val().length <= 30)"
        },
        "photo": {
          ".validate": "root.child('admins').child(auth.uid).exists() || (newData.isString() && newData.val().length <= 15000)"
        },
        "xp": {
          ".validate": "root.child('admins').child(auth.uid).exists() || (newData.isNumber() && newData.val() >= 0 && newData.val() <= (data.exists() ? data.val() : 0) + 300)"
        },
        "streak": {
          ".validate": "root.child('admins').child(auth.uid).exists() || (newData.isNumber() && newData.val() >= 0 && newData.val() <= 5000)"
        },
        "last": {
          ".validate": "root.child('admins').child(auth.uid).exists() || (newData.isString() && newData.val().length <= 10)"
        },
        "days": {
          "$d": {
            "ci": {
              ".validate": "root.child('admins').child(auth.uid).exists() || (newData.val() === 1 && !data.exists())"
            },
            "s": {
              ".validate": "root.child('admins').child(auth.uid).exists() || (newData.isNumber() && newData.val() >= 0 && newData.val() <= 10 && !data.exists())"
            },
            "sh": {
              ".validate": "root.child('admins').child(auth.uid).exists() || (newData.isNumber() && newData.val() >= (data.exists() ? data.val() : 0) && newData.val() <= (data.exists() ? data.val() : 0) + 1 && newData.val() <= 20)"
            },
            "shr": {
              ".validate": "root.child('admins').child(auth.uid).exists() || (newData.isNumber() && newData.val() >= (data.exists() ? data.val() : 0) && newData.val() <= 4 && newData.val() * 5 <= newData.parent().child('sh').val())"
            },
            "w": {
              ".validate": "root.child('admins').child(auth.uid).exists() || (newData.isNumber() && newData.val() >= 1 && newData.val() <= 7 && !data.exists())"
            },
            "mb": {
              ".validate": "root.child('admins').child(auth.uid).exists() || (newData.val() === 1 && !data.exists())"
            },
            "$other": {
              ".validate": "root.child('admins').child(auth.uid).exists()"
            }
          }
        },
        "wk": {
          "$w": {
            ".validate": "root.child('admins').child(auth.uid).exists() || (newData.val() === 1 && !data.exists())"
          }
        },
        "bonus": {
          "$b": {
            ".validate": "root.child('admins').child(auth.uid).exists() || (newData.isNumber() && newData.val() >= 0 && newData.val() <= 20 && !data.exists() && now >= 1793901600000 && now <= 1793928600000)"
          }
        },
        "ach": {
          "$a": {
            ".validate": "root.child('admins').child(auth.uid).exists() || (newData.isNumber() && !data.exists())"
          }
        },
        "$other": {
          ".validate": "root.child('admins').child(auth.uid).exists()"
        },
        "bz": {
          "s": {
            ".validate": "root.child('admins').child(auth.uid).exists() || (newData.isNumber() && newData.val() >= 0 && newData.val() <= 30 && !data.exists())"
          },
          "x": {
            ".validate": "root.child('admins').child(auth.uid).exists() || (newData.isNumber() && newData.val() >= 0 && newData.val() <= 200 && !data.exists())"
          },
          "t": {
            ".validate": "root.child('admins').child(auth.uid).exists() || (newData.isNumber() && !data.exists())"
          },
          "$other": {
            ".validate": "root.child('admins').child(auth.uid).exists()"
          }
        },
        "pin": {
          ".validate": "root.child('admins').child(auth.uid).exists() || (newData.isString() && (newData.val() === 'birds' || newData.val() === 'chihiro' || newData.val() === 'lunch') && ((!data.exists() && root.child('bzr').child($uid).exists()) || root.child('pins').child(newData.val()).child($uid).exists()))"
        },
        "own": {
          "$k": {
            ".validate": "root.child('admins').child(auth.uid).exists() || (newData.val() === 1 && !data.exists() && ($k === 'neon' || $k.matches(/^f_[a-z0-9_]{1,20}$/)))"
          }
        },
        "fx": {
          ".validate": "root.child('admins').child(auth.uid).exists() || (newData.val() === 'neon' && newData.parent().child('own').child('neon').exists())"
        },
        "frame": {
          ".validate": "root.child('admins').child(auth.uid).exists() || (newData.isString() && newData.val().length <= 20 && newData.parent().child('own').child('f_' + newData.val()).exists())"
        }
      },
      ".read": "root.child('admins').child(auth.uid).exists()"
    },
    "rank": {
      ".read": true,
      ".indexOn": [
        "x"
      ],
      "$uid": {
        ".write": "root.child('admins').child(auth.uid).exists() || (auth != null && auth.uid === $uid)",
        ".validate": "root.child('admins').child(auth.uid).exists() || (newData.hasChildren(['n', 'x']))",
        "n": {
          ".validate": "root.child('admins').child(auth.uid).exists() || (newData.isString() && newData.val().length >= 1 && newData.val().length <= 30)"
        },
        "p": {
          ".validate": "root.child('admins').child(auth.uid).exists() || (newData.isString() && newData.val().length <= 15000)"
        },
        "x": {
          ".validate": "root.child('admins').child(auth.uid).exists() || (newData.isNumber() && newData.val() >= 0 && newData.val() <= (data.exists() ? data.val() : 0) + 300)"
        },
        "g": {
          ".validate": "root.child('admins').child(auth.uid).exists() || (newData.val() === 1)"
        },
        "$other": {
          ".validate": "root.child('admins').child(auth.uid).exists()"
        },
        "b": {
          ".validate": "root.child('admins').child(auth.uid).exists() || (newData.isString() && (newData.val() === 'birds' || newData.val() === 'chihiro' || newData.val() === 'lunch'))"
        },
        "f": {
          ".validate": "root.child('admins').child(auth.uid).exists() || (newData.isString() && newData.val().length <= 20 && root.child('users').child($uid).child('own').child('f_' + newData.val()).exists())"
        }
      }
    },
    "bzr": {
      ".read": true,
      "$uid": {
        ".write": "auth != null && auth.uid === $uid && newData.exists() && !data.exists()",
        ".validate": "newData.hasChildren(['t'])",
        "t": {
          ".validate": "newData.isNumber()"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "pins": {
      ".read": true,
      "$pin": {
        "$uid": {
          ".write": "root.child('admins').child(auth.uid).exists() || (auth != null && auth.uid === $uid && newData.exists() && !data.exists() && root.child('bzr').child($uid).exists())",
          ".validate": "root.child('admins').child(auth.uid).exists() || (newData.isNumber() && ($pin === 'birds' || $pin === 'chihiro' || $pin === 'lunch'))"
        }
      }
    },
    "admins": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid"
      }
    },
    "verified": {
      ".read": true,
      "$uid": {
        ".write": "root.child('admins').child(auth.uid).exists()",
        ".validate": "newData.val() === true"
      }
    },
    "arvore": {
      ".read": true,
      "$id": {
        ".write": "root.child('admins').child(auth.uid).exists()"
      }
    },
    "arvoreMeta": {
      ".read": true,
      ".write": "root.child('admins').child(auth.uid).exists()"
    },
    "cartaLast": {
      "$uid": {
        ".write": "auth != null && auth.uid === $uid && newData.val() === now",
        ".validate": "newData.isNumber()"
      }
    },
    "cartas": {
      "ok": {
        ".read": "now >= 1798081200000",
        ".indexOn": [
          "nl"
        ],
        "$id": {
          ".write": "root.child('admins').child(auth.uid).exists()"
        }
      },
      "pend": {
        "$uid": {
          ".read": "root.child('admins').child(auth.uid).exists() || (auth != null && auth.uid === $uid)",
          "$id": {
            ".write": "root.child('admins').child(auth.uid).exists() || (auth != null && auth.uid === $uid && !data.exists() && newData.exists() && now < 1798081200000 && (!root.child('cartaLast').child($uid).exists() || now - root.child('cartaLast').child($uid).val() >= 25000))",
            ".validate": "root.child('admins').child(auth.uid).exists() || newData.hasChildren(['n', 'e', 'm', 't'])",
            "n": {
              ".validate": "root.child('admins').child(auth.uid).exists() || (newData.isString() && newData.val() === root.child('users').child($uid).child('name').val())"
            },
            "e": {
              ".validate": "root.child('admins').child(auth.uid).exists() || (newData.isString() && newData.val().length >= 1 && newData.val().length <= 20)"
            },
            "m": {
              ".validate": "root.child('admins').child(auth.uid).exists() || (newData.isString() && newData.val().length >= 100 && newData.val().length <= 1500)"
            },
            "t": {
              ".validate": "root.child('admins').child(auth.uid).exists() || newData.val() === now"
            },
            "$other": {
              ".validate": "root.child('admins').child(auth.uid).exists()"
            }
          }
        }
      }
    }
  }
}
